# Copy to .env and fill in. With no provider keys the gateway runs on mock providers.
# GATEWAY_API_KEYS entries are key or key:capacity:refill_per_sec
GATEWAY_API_KEYS=demo-key,bench-key:1000000:1000000
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=5

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Vendors retire model names over time. These were current as of Sept 2026 —
# check each vendor's docs and update if a 404 "model not found" error appears.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-3.8-flash
# Priority order (defaults to the providers that have keys):
# PROVIDER_ORDER=openai,anthropic,gemini
# Force mock providers even if keys are set:
# USE_MOCKS=1

REQUEST_TIMEOUT_S=5
MAX_RETRIES=1
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_S=10
